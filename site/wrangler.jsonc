{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "compiler-study-site",
  "compatibility_date": "2026-08-08",

  // 워커 스크립트 없이 정적 자산만 올린다.
  // Docusaurus 빌드 결과(build/)를 그대로 서빙한다.
  "assets": {
    "directory": "./build",
    // 없는 경로는 Docusaurus 가 만든 404 페이지로 보낸다.
    "not_found_handling": "404-page",
    // /docs/intro 로 오면 /docs/intro/index.html 을 준다.
    "html_handling": "auto-trailing-slash"
  },

  "observability": {
    "enabled": true
  }
}
